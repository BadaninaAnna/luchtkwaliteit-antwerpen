model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataUrl", "uurwaarden", "dagwaarden", "reeksen", "stoffen", "meta"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Datum
ref table uurwaarden
ref table dagwaarden
ref table reeksen
ref table stoffen
ref table meta

ref cultureInfo en-US

