	partition stoffen = m
		mode: import
		source =
			let
			    Inhoud = Csv.Document ( Web.Contents ( DataUrl & "powerbi/stoffen.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
			    Koppen = Table.PromoteHeaders ( Inhoud, [PromoteAllScalars = true] ),
			    Types = Table.TransformColumnTypes ( Koppen, {{"stof", type text}, {"naam", type text}, {"who_dag", type number}, {"eu_2030_dag", type number}, {"who_jaar", type number}, {"eu_2030_jaar", type number}, {"eu_nu_jaar", type number}, {"volgorde", Int64.Type}}, "en-US" )
			in
			    Types

	annotation PBI_ResultType = Table
