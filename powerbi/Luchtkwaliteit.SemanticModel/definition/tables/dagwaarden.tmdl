table dagwaarden
	lineageTag: 9b2ec038-f672-4156-810c-eece7628b162

	measure Gemiddelde = AVERAGE ( dagwaarden[daggemiddelde] )
		formatString: 0.0
		displayFolder: Normen
		lineageTag: f80b1273-ea02-46b0-9a68-9d7e66a81d49

	measure 'Stationsdagen boven WHO' = SUM ( dagwaarden[boven_who] )
		formatString: #,0
		displayFolder: Normen
		lineageTag: 4ab2b546-b2ea-421b-8116-9684ce9f43de

	measure 'Aandeel dagen boven WHO' = DIVIDE ( SUM ( dagwaarden[boven_who] ), COUNTROWS ( dagwaarden ) )
		formatString: 0%
		displayFolder: Normen
		lineageTag: 43883265-cf17-4e30-b94e-9ff666f595da

	measure 'Aandeel dagen boven EU 2030' = DIVIDE ( SUM ( dagwaarden[boven_eu_2030] ), COUNTROWS ( dagwaarden ) )
		formatString: 0%
		displayFolder: Normen
		lineageTag: 25293871-0221-4a4d-b0cc-58bea1648fa4

